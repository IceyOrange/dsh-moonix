{
  "name": "dsh-moonix",
  "version": "0.1.0-alpha.3",
  "description": "Connect moonix to sync recordings, transcripts and summaries from the moonix App, view personal to-dos, and quickly revisit meeting highlights and key information.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./token": "./token.js",
    "./oauth": "./oauth.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.webp",
    "./token/locale/*.json": "./locale/*.json",
    "./token/icon": "./icon.webp",
    "./oauth/locale/*.json": "./locale/*.json",
    "./oauth/icon": "./icon.webp"
  },
  "files": [
    "index.js",
    "token.js",
    "oauth.js",
    "register.js",
    "locale",
    "icon.webp",
    "DETAIL*.md",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "moonix",
    "mcp",
    "oauth",
    "recordings"
  ],
  "author": {
    "name": "moonix",
    "url": "https://moonix.cn"
  },
  "license": "MIT",
  "homepage": "https://moonix.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceyOrange/dsh-moonix.git"
  },
  "bugs": {
    "url": "https://github.com/IceyOrange/dsh-moonix/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.webp"
}
